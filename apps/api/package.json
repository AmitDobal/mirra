    "test:context": "tsx scripts/assert-personalization-context.ts && tsx scripts/assert-goal-prompts.ts",
    "test:chef": "tsx scripts/assert-recipe-safety.ts",
    "test:nutrition": "tsx scripts/assert-nutrition-history.ts",
    "test:account-delete": "tsx scripts/assert-account-deletion.ts",
    "test:streaks": "tsx scripts/assert-streaks.ts",
    "test:badges": "tsx scripts/assert-badges.ts",
    "test:auth": "tsx scripts/assert-auth-harden.ts",
    "test:meal-revise": "tsx scripts/assert-meal-revise.ts",
    "test:revise-caps": "tsx scripts/assert-revise-caps.ts",
    "test:revise-drafts": "tsx scripts/assert-revise-drafts.ts",
    "test:exercise-resolve": "tsx scripts/assert-exercise-resolve.ts",
    "test:workout-revise": "tsx scripts/assert-workout-revise.ts",
    "test:strength": "tsx scripts/assert-strength.ts",
    "test:workout-edit": "tsx scripts/assert-workout-edit.ts",
    "test:chat-quality": "tsx scripts/assert-chat-quality.ts",
    "test:chat-intents": "tsx scripts/assert-chat-intents.ts",
    "test:profile-update": "tsx scripts/assert-profile-update.ts",
    "test:onboarding-guard": "tsx scripts/assert-onboarding-guard.ts",
    "test:goal": "tsx scripts/assert-goal.ts",
    "test:goal-api": "tsx scripts/assert-goal-api.ts",
    "test:goal-impact": "tsx scripts/assert-goal-impact.ts",
    "test:local-dates": "tsx scripts/assert-local-dates.ts",
    "smoke:meal-revise": "node scripts/smoke-meal-revise.mjs",
    "smoke:revise-caps": "node scripts/smoke-revise-caps.mjs",
    "smoke:streaks": "node scripts/smoke-streaks.mjs",
    "smoke:badges": "node scripts/smoke-badges.mjs",
    "smoke:notifications": "node scripts/smoke-notifications.mjs",
    "smoke:chef": "node scripts/smoke-chef.mjs",
    "smoke:strength": "node scripts/smoke-strength.mjs",
    "smoke:goal": "node scripts/smoke-goal.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply mirra-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply mirra-db --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.14",
    "@mirra/contracts": "*",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250917.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "wrangler": "^4.37.0"
  }
}
