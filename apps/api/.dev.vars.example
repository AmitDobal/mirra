# Copy to .dev.vars (gitignored). Never commit real keys.
ALLOW_DEV_USER_HEADER=true

# openai | heuristic | anthropic | workers-ai (empty = auto)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

