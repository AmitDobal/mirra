# Copy to .dev.vars (gitignored). Never commit real keys.
ALLOW_DEV_USER_HEADER=true
APP_URL=http://127.0.0.1:8787

# Better Auth (required for Google; local fallback exists without this)
BETTER_AUTH_SECRET=replace-with-long-random-string

# Google OAuth (both required to enable Continue with Google end-to-end)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# openai | heuristic | anthropic | workers-ai (empty = auto)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Reserved — wire adapters then set AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Spoken coach cues (optional). No key = text-only cues (stub).
# VOICE_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2
