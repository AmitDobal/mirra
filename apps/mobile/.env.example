# Copy to .env (gitignored). Restart Expo after changes.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8787
EXPO_PUBLIC_MIRRA_USER_ID=day-test-1
# Show Dev Tester outside __DEV__ (preview builds). Never enable for App Store builds.
EXPO_PUBLIC_ALLOW_DEV_AUTH=true

# Google OAuth (required for Continue with Google). Use the Web client ID.
# Also set matching GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET on the API.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
