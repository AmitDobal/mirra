{
  "expo": {
    "name": "Mirra",
    "slug": "mirra",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mirra",
    "userInterfaceStyle": "dark",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ai.mirra.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Mirra uses the camera for an optional mirror selfie to track shape progress.",
        "NSPhotoLibraryUsageDescription": "Mirra can use a photo from your library for an optional mirror selfie."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#131313",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "ai.mirra.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "androidStatusBar": {
      "backgroundColor": "#131313",
      "barStyle": "light-content",
      "translucent": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "backgroundColor": "#131313"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Mirra uses the camera for an optional mirror selfie to track shape progress.",
          "photosPermission": "Mirra can use a photo from your library for an optional mirror selfie."
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      ["expo-audio", { "microphonePermission": false }]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://mirra-api.amit-dobalwork.workers.dev",
      "mirraUserId": "day-test-1",
      "allowDevAuth": true,
      "router": {},
      "eas": {
        "projectId": "c0deee59-d915-4467-836d-accec54fbdd3"
      }
    },
    "owner": "amitdobal141",
    "updates": {
      "url": "https://u.expo.dev/c0deee59-d915-4467-836d-accec54fbdd3"
    }
  }
}
