{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mirra-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "vars": {
    "APP_NAME": "mirra",
    "APP_VERSION": "0.1.0",
    // DEV / day-test — enables x-mirra-user-id. Turn off for real prod auth.
    "ALLOW_DEV_USER_HEADER": "true",
    "AI_PROVIDER": "openai"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mirra-db",
      "database_id": "853253fb-289b-4ef1-a2b8-5f0b17f415e8",
      "migrations_dir": "src/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "mirra-media"
    }
  ]
}
