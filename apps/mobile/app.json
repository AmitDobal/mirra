{
  "expo": {
    "name": "Mirra",
    "slug": "mirra",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mirra",
    "userInterfaceStyle": "dark",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ai.mirra.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#131313",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "ai.mirra.app"
    },
    "androidStatusBar": {
      "backgroundColor": "#131313",
      "barStyle": "light-content",
      "translucent": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "backgroundColor": "#131313"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-sqlite",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://mirra-api.amit-dobalwork.workers.dev",
      "mirraUserId": "day-test-1",
      "router": {},
      "eas": {
        "projectId": "c0deee59-d915-4467-836d-accec54fbdd3"
      }
    },
    "owner": "amitdobal141",
    "updates": {
      "url": "https://u.expo.dev/c0deee59-d915-4467-836d-accec54fbdd3"
    }
  }
}
